DATABASE_URL=postgres://tienda3d:change-me@localhost:5432/tienda3d
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

UPLOADS_DIR=./public/uploads
UPLOADS_MAX_SIZE_MB=20

# Clave AES-256 (32 bytes en hex) para encriptar secretos guardados en la DB
# (ej. contrasena SMTP). Generar con: openssl rand -hex 32
# (o: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SETTINGS_ENCRYPTION_KEY=

# Umami (analytics self-hosted, ver docs/). Website ID y URL del script
# vienen de Settings -> Websites en tu instancia de Umami. Sin estas dos
# variables, UmamiScript no renderiza nada (no rompe el build/dev local).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://analytics.roostercode.tech/script.js

# GlitchTip (error tracking self-hosted, protocolo compatible con Sentry).
# El DSN se copia desde el proyecto en tu instancia de GlitchTip. Las dos
# variables llevan el mismo valor -- GLITCHTIP_DSN la lee el servidor
# (instrumentation.ts), NEXT_PUBLIC_GLITCHTIP_DSN el navegador
# (instrumentation-client.ts, necesita el prefijo NEXT_PUBLIC_ para que Next
# la incluya en el bundle de cliente). Sin esto, Sentry.init no corre (no
# rompe nada, solo no reporta).
GLITCHTIP_DSN=
NEXT_PUBLIC_GLITCHTIP_DSN=
